{
  "name": "edutrack-africa",
  "version": "1.0.0",
  "private": true,
  "description": "School Management System for African Schools",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @edutrack/web run dev",
    "dev:desktop": "pnpm --filter @edutrack/desktop run dev",
    "build": "pnpm --filter @edutrack/domain run build && pnpm --filter @edutrack/shared run build && pnpm --filter @edutrack/ui run build && pnpm --filter @edutrack/db run build && pnpm --filter @edutrack/api run build && pnpm --filter @edutrack/web run build",
    "build:desktop": "pnpm --filter @edutrack/desktop run build",
    "check:desktop": "pnpm --filter @edutrack/desktop run check",
    "verify:sidecar": "pnpm --filter @edutrack/api run verify:sidecar",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --filter @edutrack/db run test && pnpm --filter @edutrack/api run test && pnpm --filter @edutrack/web run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @edutrack/db run db:generate",
    "db:migrate": "pnpm --filter @edutrack/db run db:migrate",
    "db:seed": "pnpm --filter @edutrack/db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  }
}

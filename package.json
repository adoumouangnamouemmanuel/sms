{
  "name": "edutrack-africa",
  "version": "1.0.0",
  "private": true,
  "description": "School Management System for African Schools",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @edutrack/db run db:generate",
    "db:migrate": "pnpm --filter @edutrack/db run db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}

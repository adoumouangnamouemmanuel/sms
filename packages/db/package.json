{
  "name": "@edutrack/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate:sqlite --config=drizzle.sqlite.config.ts",
    "db:migrate": "drizzle-kit push:sqlite --config=drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "drizzle-orm": "^0.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^24.10.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.20.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

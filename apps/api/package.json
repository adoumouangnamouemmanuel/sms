{
  "name": "@edutrack/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:sidecar": "pnpm --filter @edutrack/shared run build && pnpm --filter @edutrack/db run build && pnpm run build && node scripts/build-sidecar.mjs",
    "verify:sidecar": "node scripts/verify-sidecar.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@edutrack/db": "workspace:*",
    "@edutrack/domain": "workspace:*",
    "@edutrack/shared": "workspace:*",
    "@fastify/multipart": "^9.4.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "13.0.2",
    "fastify": "^5.12.0",
    "jose": "^6.1.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

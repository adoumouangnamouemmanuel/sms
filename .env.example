# EduTrack Africa local development environment.
# Copy to .env and replace every placeholder with local-only values.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Fastify sidecar
EDUTRACK_API_HOST=127.0.0.1
# Use 0 during desktop packaging to let the sidecar choose an available loopback port.
EDUTRACK_API_PORT=5174
EDUTRACK_ALLOWED_ORIGIN=http://127.0.0.1:5173
EDUTRACK_SESSION_SECRET=replace-with-a-random-32-byte-local-development-secret

# SQLite system of record for Version 1
EDUTRACK_SQLITE_PATH=./.data/edutrack.sqlite

# Optional browser-only development override. The desktop app injects its sidecar URL at runtime.
VITE_EDUTRACK_API_URL=http://127.0.0.1:5174
